def get_matrix(n, m, value):
    if n <= 0 or m <= 0:
        return []

    matrix = []

    for _ in range(n):
        row = []

        for _ in range(m):
            row.append(value)

        matrix.append(row)

    return matrix

result1 = get_matrix(5, 5, 2)
result2 = get_matrix(10, 1, 854)
result3 = get_matrix(2, 2, 13)

print(result1)
print(result2)
print(result3)
